<!--
    Primitive Ascent - Minimal Custom Ore Generation config

    Use this as your editable starting point.

    IMPORTANT:
    Rename/copy this file to:
        minecraft/config/CustomOreGen_Config.xml

    This file intentionally removes the giant default template imports
    so you can learn one system at a time.
-->

<Config>

    <!-- ============================================================
         Global options
         ============================================================ -->
    <ConfigSection>

        <!-- Keep COG active only in the overworld. -->
        <OptionDisplayGroup name='groupInternal' displayName='' displayState='hidden'/>

        <OptionChoice name='COGActive'
                      default=':= dimension="overworld"'
                      displayGroup='groupInternal'>
            <Choice value='true' displayValue='On'/>
            <Choice value='false' displayValue='Off'/>
        </OptionChoice>

        <OptionDisplayGroup name='groupGeneral'
                            displayName='General'
                            displayState='shown'/>

        <!-- Global multipliers. Leave these at 1 while learning. -->
        <OptionNumeric name='oreFreq'
                       default='1'
                       min='0'
                       max='5'
                       displayState='shown'
                       displayGroup='groupGeneral'>
            <DisplayName>Ore Frequency</DisplayName>
        </OptionNumeric>

        <OptionNumeric name='oreSize'
                       default='1'
                       min='0'
                       max='5'
                       displayState='shown'
                       displayGroup='groupGeneral'>
            <DisplayName>Ore Deposit Size</DisplayName>
        </OptionNumeric>

        <!-- Debug options. Keep debugDist true while testing. -->
        <OptionChoice name='debugMode'
                      default='true'
                      displayState='shown_dynamic'
                      displayGroup='groupGeneral'>
            <DisplayName>Debugging Mode</DisplayName>
            <Choice value='true' displayValue='On'/>
            <Choice value='false' displayValue='Off'/>
        </OptionChoice>

        <OptionChoice name='drawWireframes'
                      default='true'
                      displayGroup='groupGeneral'>
            <DisplayName>Distribution Wireframes</DisplayName>
            <Choice value='true' displayValue='On'/>
            <Choice value='false' displayValue='Off'/>
        </OptionChoice>

        <OptionChoice name='debugDist'
                      default='true'
                      displayGroup='groupGeneral'>
            <DisplayName>Test Distributions</DisplayName>
            <Choice value='true' displayValue='On'/>
            <Choice value='false' displayValue='Off'/>
        </OptionChoice>

        <!-- Required internal option. Do not remove unless you know COG well. -->
        <OptionNumeric name='deferredPopulationRange'
                       default='16'
                       displayGroup='groupGeneral'>
            <DisplayName>Deferred Chunk Gen. Range</DisplayName>
            <Min>0</Min>
            <Max>128</Max>
            <DisplayIncrement>16</DisplayIncrement>
        </OptionNumeric>

    </ConfigSection>


    <!-- ============================================================
         Presets

         Presets do NOT generate ore by themselves.
         They are reusable shapes/settings for real distributions below.
         ============================================================ -->
    <ConfigSection>

        <VeinsPreset name='PresetPrimitiveLayeredVein' branchType='Bezier'>
            <Description>
                Beginner-friendly layered vein shape for Primitive Ascent.
                Used by the prototype iron vein below.
            </Description>

            <!-- How often motherlodes attempt to appear. -->
            <Setting name='MotherlodeFrequency' avg=':= 0.025 * oreFreq'/>

            <!-- Central blob size. -->
            <Setting name='MotherlodeSize' avg=':= 4 * oreSize' range=':= 2 * oreSize'/>

            <!-- Rough vertical position. Around Y=32 with variation. -->
            <Setting name='MotherlodeHeight' avg='32' range='12' type='normal'/>
            <Setting name='MotherlodeRangeLimit' avg='32' range='32' type='normal'/>

            <!-- Branches coming out from the motherlode. -->
            <Setting name='BranchFrequency' avg='3' range='1'/>
            <Setting name='BranchInclination' avg='0' range='0.35'/>
            <Setting name='BranchLength' avg='80' range='30'/>
            <Setting name='BranchHeightLimit' avg='32'/>

            <!-- Shape and thickness of vein segments. -->
            <Setting name='SegmentForkFrequency' avg='0.15'/>
            <Setting name='SegmentForkLengthMult' avg='0.75' range='0.25'/>
            <Setting name='SegmentLength' avg='12' range='4'/>
            <Setting name='SegmentAngle' avg='0.45' range='0.35'/>
            <Setting name='SegmentPitch' avg='0.35' range='0.35'/>
            <Setting name='SegmentRadius' avg=':= 0.9 * oreSize' range=':= 0.3 * oreSize'/>

            <!-- 1.0 means dense/solid ore placement inside the vein shape. -->
            <Setting name='OreDensity' avg='1' range='0'/>
            <Setting name='OreRadiusMult' avg='1.0' range='0.1'/>

            <!-- Only replace normal stone for now. -->
            <ReplacesOre block='stone'/>

            <!-- Allow all biomes for the prototype. -->
            <Biome name='.*'/>
        </VeinsPreset>

    </ConfigSection>


    <!-- ============================================================
         Primitive Ascent prototype distributions

         Real ore generation begins here.
         ============================================================ -->
    <ConfigSection>

        <Veins name='PrimitiveIronVein'
               inherits='PresetPrimitiveLayeredVein'
               block='minecraft:iron_ore'>
            <Description>
                First Primitive Ascent ore generation prototype.
                Generates vanilla iron ore using a custom vein shape.
            </Description>
        </Veins>

    </ConfigSection>

</Config>
